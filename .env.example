# ===== الأساسيات =====
# رابط الموقع النهائي (بدون / في الآخر) — مهم لـ SEO والدفع
SITE_URL=https://your-domain.com
PORT=3000

# كلمة مرور لوحة التحكم /admin  (اختر كلمة قوية)
ADMIN_PASSWORD=change-me-to-a-strong-password

# مكان حفظ البيانات (المنصات، الأعمال، الإعدادات)
DATA_DIR=./data

# ===== المزامنة التلقائية =====
# مفتاح مجاني من https://www.themoviedb.org/settings/api  (API Key أو Read Access Token)
TMDB_API_KEY=

# ===== الدفع — Paymob =====
# من لوحة Paymob → Settings → Account Info
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# PAYMOB_BASE_URL=https://accept.paymob.com   (للسعودية: https://ksa.paymob.com — لعُمان: https://oman.paymob.com)

# ===== متقدم (اختياري) =====
# true = تشغيل الموقع ببيانات تجريبية فقط بدون سيرفر
NEXT_PUBLIC_USE_MOCK=false
# اتركه فاضي لاستخدام الـ API المدمج. املأه فقط لو عندك باك إند خارجي.
NEXT_PUBLIC_API_BASE_URL=
# INTERNAL_API_URL=http://127.0.0.1:3000
